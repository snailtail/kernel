# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me
# Password for the initial "admin" user, used only on first start. If empty, one is generated and logged.
KERNEL_ADMIN_PASSWORD=
# Host port for the web UI, REST API and MCP endpoint.
KERNEL_PORT=8080
# Set to true when served over HTTPS (behind a TLS-terminating reverse proxy).
KERNEL_SECURE_COOKIES=false
KERNEL_TRUST_PROXY=false
# MCP endpoint shown in Settings, e.g. when MCP is only reachable on the LAN. Defaults to the URL the UI is opened on.
KERNEL_MCP_URL=

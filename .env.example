# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me
# Password for the initial "admin" user, used only on first start. If empty, one is generated and logged.
KERNEL_ADMIN_PASSWORD=
# Host port for the web UI, REST API and MCP endpoint.
KERNEL_PORT=8080
# Set to true when served over HTTPS (behind a TLS-terminating reverse proxy).
KERNEL_SECURE_COOKIES=false
KERNEL_TRUST_PROXY=false
# MCP endpoint shown in Settings, e.g. when MCP is only reachable on the LAN. Defaults to the URL the UI is opened on.
KERNEL_MCP_URL=
# Public URL of the web UI, used for links in webhook messages (e.g. https://kernel.example.com).
KERNEL_PUBLIC_URL=
# Backups: directory on the host, time of day (in TZ) and retention.
KERNEL_BACKUP_DIR=./backups
KERNEL_BACKUP_TIME=02:30
TZ=Europe/Stockholm
# Logs: json (default) or ecs (Elastic Common Schema, for Filebeat / Elastic Agent).
KERNEL_LOG_FORMAT=json
# OpenTelemetry traces and metrics over OTLP (Elastic APM / EDOT collector). Empty = disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Key that encrypts stored secrets (webhook signing secrets) at rest: at least 32 random characters,
# e.g. `openssl rand -base64 32`. Keep it out of backups. Required to create webhooks.
KERNEL_SECRET_KEY=
# Outbound requests (webhooks) may not reach private networks unless allowed here: comma-separated CIDRs/addresses.
KERNEL_OUTBOUND_ALLOW=
# Password for the least-privilege database role (kernel_app) the app runs as. Strongly recommended:
# without it the app runs as the database owner and could alter the audit trail.
KERNEL_APP_DB_PASSWORD=
# Password for the read-only reporting role (kernel_reporting) that Power BI or Grafana use to read the views in the
# reporting schema: no free text, no personal data, no restricted records. Leave empty to have no such role.
# See docs/reporting.md.
KERNEL_REPORTING_DB_PASSWORD=

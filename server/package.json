{
  "name": "@kernel/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "exports", "nsExports", "types", "nsTypes", "duplicates"],
  "workspaces": {
    "server": {
      "entry": ["src/telemetry.ts", "scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "entry": ["test/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
